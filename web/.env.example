NEXT_PUBLIC_LIFF_ID=             # 學生選課頁用的 LIFF ID；空白 = 展示模式（不需 LINE 即可預覽）
NEXT_PUBLIC_TEACHER_LIFF_ID=     # 老師管理頁用的 LIFF ID（開啟「分享到 LINE」shareTargetPicker 用）；空白 = 退回複製文字
LINE_LOGIN_CHANNEL_ID=           # LINE Login 頻道的 Channel ID，用來驗證 ID Token
LINE_CHANNEL_SECRET=             # Messaging API 頻道的 Channel secret，驗證 webhook 簽章用；只放伺服器端
LINE_CHANNEL_ACCESS_TOKEN=       # Messaging API 頻道的 long-lived access token，推播／回覆訊息用；只放伺服器端
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=       # 只放伺服器端，絕不可加 NEXT_PUBLIC_
